# Template production: HTTPS melalui reverse proxy pada host yang sama.
# WAJIB sesuaikan URL, APP_SECRET, dan ADMIN_PASSWORD_HASH sebelum menjalankan.
# Jangan commit .env atau key credential ke repository.
NODE_ENV=production

# ============================================================
# APPLICATION TIMEZONE
# ============================================================
# Gunakan timezone IANA sesuai wilayah operasional bot.
#
# Indonesia Barat (WIB)
TZ=Asia/Jakarta
#
# Indonesia Tengah (WITA)
# TZ=Asia/Makassar
#
# Indonesia Timur (WIT)
# TZ=Asia/Jayapura

PORT=3000
# Aktifkan hanya setelah konfigurasi, database, dan akses admin diverifikasi.
AUTO_START=false

# WAJIB ganti dengan secret unik. Generate 32 byte acak sebagai hex:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-this-secret
# WAJIB ganti dengan URL upstream Pusaka yang benar, bukan URL dashboard.
BASE_URL_PUSAKA=https://example.go.id
# WAJIB ganti dengan origin HTTPS dashboard sendiri (tanpa path).
APP_BASE_URL=https://bot.example.com

HEADLESS=true
BOT_DELAY=3000
NAVIGATION_TIMEOUT=30000
ELEMENT_TIMEOUT=30000
MAX_RETRY=3
RETRY_DELAY=3000

# Retry scheduler setelah satu proses presensi gagal total.
SCHEDULE_RETRY_BASE_SECONDS=30
SCHEDULE_RETRY_JITTER_SECONDS=15
SCHEDULE_RETRY_MAX_SECONDS=90

MAX_CONCURRENT=1
TASK_TIMEOUT=180000

COOKIE_DIR=cookies
LOG_LEVEL=info

# Fallback koordinat, bukan deteksi lokasi otomatis. 0,0 adalah lokasi nyata.
# Isi koordinat user dengan benar; sesuaikan fallback jika digunakan.
DEFAULT_LAT=0
DEFAULT_LNG=0
GEO_RADIUS_METERS=50

# Optional. Jika kosong, aplikasi otomatis membuat .secrets/credential.key.
# Jika diisi, gunakan 32-byte key dalam base64 atau 64 karakter hex.
# Pertahankan key yang sama saat deploy agar credential lama dapat didekripsi.
# Cadangkan key secara privat bersama rencana pemulihan database, bukan di Git.
# CREDENTIAL_ENCRYPTION_KEY=

# Holiday provider fallback
HOLIDAY_TIMEOUT_MS=5000
HOLIDAY_PRIMARY_BASE_URL=https://api.kemendesa.link/libur-nasional/api
HOLIDAY_SECONDARY_BASE_URL=https://data-libur-nasional-indonesia.vercel.app/api
HOLIDAY_CACHE_FILE=data/holiday-cache.json
HOLIDAY_OVERRIDES_FILE=data/holiday-overrides.json

# Structured logging
STRUCTURED_LOG_DIR=logs
STRUCTURED_LOG_RETENTION_DAYS=7
AUDIT_LOG_RETENTION_DAYS=90

# Weekly database backup
DB_BACKUP_ENABLED=true
# node-cron: detik menit jam tanggal bulan hari; Minggu 01:00 sesuai TZ.
DB_BACKUP_CRON=0 0 1 * * 0
DB_BACKUP_DIR=backups/database
DB_BACKUP_RETENTION_COUNT=4

# Admin login
ADMIN_USERNAME=admin
# WAJIB ganti placeholder dengan hash dari: npm run admin:hash
# Jangan isi password plaintext di sini.
ADMIN_PASSWORD_HASH=$2b$12$replace-with-generated-bcrypt-hash
SESSION_COOKIE_NAME=pusaka_admin_sid
# Production HTTPS wajib menggunakan secure cookie.
SESSION_COOKIE_SECURE=true
SESSION_SAME_SITE=lax
SESSION_MAX_AGE_MS=28800000

# Production security
SECURITY_HEADERS_ENABLED=true
CSRF_PROTECTION_ENABLED=true
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
LOGIN_LOCKOUT_MS=900000

# Reverse proxy / HTTPS (P5)
# Apache/Nginx/Caddy pada host yang sama: percaya hanya proxy loopback.
# Proxy harus menimpa X-Forwarded-Proto sesuai koneksi asli client.
# Batasi akses langsung ke port Node; trust proxy bukan pengganti firewall.
# Do NOT use TRUST_PROXY=true in production. For a remote proxy, use an explicit
# hop count, IP/CIDR, or named subnet supported by Express.
TRUST_PROXY=loopback
FORCE_HTTPS=true

# HSTS is emitted only on requests Express recognizes as HTTPS.
HSTS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000
# Safer default: do not cover unrelated subdomains until the domain topology is known.
HSTS_INCLUDE_SUBDOMAINS=false

# Hanya untuk development HTTP lokal, ubah konfigurasi terkait bersama-sama:
# NODE_ENV=development
# APP_BASE_URL=http://localhost:3000
# TRUST_PROXY=false
# FORCE_HTTPS=false
# SESSION_COOKIE_SECURE=false
