NODE_ENV=production
TZ=Asia/Jakarta
PORT=3000
AUTO_START=true

APP_SECRET=change-this-secret
# Upstream Pusaka automation target (not the dashboard).
BASE_URL_PUSAKA=https://example.go.id
# Public dashboard origin. Use the HTTPS domain for production deployment.
APP_BASE_URL=http://localhost:3000

HEADLESS=true
BOT_DELAY=3000
NAVIGATION_TIMEOUT=30000
ELEMENT_TIMEOUT=30000
MAX_RETRY=3
RETRY_DELAY=3000

# Retry scheduler setelah satu proses presensi gagal total.
SCHEDULE_RETRY_BASE_SECONDS=30
SCHEDULE_RETRY_JITTER_SECONDS=15
SCHEDULE_RETRY_MAX_SECONDS=90

MAX_CONCURRENT=1
TASK_TIMEOUT=180000

COOKIE_DIR=cookies
LOG_LEVEL=info

DEFAULT_LAT=0
DEFAULT_LNG=0
GEO_RADIUS_METERS=100

# Optional. Jika kosong, aplikasi otomatis membuat .secrets/credential.key.
# Jika diisi, gunakan 32-byte key dalam base64 atau 64 karakter hex.
# CREDENTIAL_ENCRYPTION_KEY=

# Holiday provider fallback
HOLIDAY_TIMEOUT_MS=5000
HOLIDAY_PRIMARY_BASE_URL=https://api.kemendesa.link/libur-nasional/api
HOLIDAY_SECONDARY_BASE_URL=https://data-libur-nasional-indonesia.vercel.app/api
HOLIDAY_CACHE_FILE=data/holiday-cache.json
HOLIDAY_OVERRIDES_FILE=data/holiday-overrides.json

# Structured logging
STRUCTURED_LOG_DIR=logs
STRUCTURED_LOG_RETENTION_DAYS=7
AUDIT_LOG_RETENTION_DAYS=90

# Weekly database backup (WIB / Asia/Jakarta)
DB_BACKUP_ENABLED=true
# node-cron: detik menit jam tanggal bulan hari; default Minggu 01:00 WIB
DB_BACKUP_CRON=0 0 1 * * 0
DB_BACKUP_DIR=backups/database
DB_BACKUP_RETENTION_COUNT=8

# Admin login
ADMIN_USERNAME=admin
# Generate with: npm run admin:hash
ADMIN_PASSWORD_HASH=$2b$12$replace-with-generated-bcrypt-hash
SESSION_COOKIE_NAME=pusaka_admin_sid
# false untuk HTTP localhost; ubah true jika sudah di belakang HTTPS production.
SESSION_COOKIE_SECURE=false
SESSION_SAME_SITE=lax
SESSION_MAX_AGE_MS=28800000

# Production security
SECURITY_HEADERS_ENABLED=true
CSRF_PROTECTION_ENABLED=true
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
LOGIN_LOCKOUT_MS=900000

# Reverse proxy / HTTPS (P5)
# Direct localhost HTTP: keep all three values below as false.
# Nginx/Caddy on the same host: TRUST_PROXY=loopback is the recommended baseline.
# Do NOT use TRUST_PROXY=true in production. For a remote proxy, use an explicit
# hop count, IP/CIDR, or named subnet supported by Express.
TRUST_PROXY=false
FORCE_HTTPS=false

# HSTS is emitted only on requests Express recognizes as HTTPS.
HSTS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000
# Safer default: do not cover unrelated subdomains until the domain topology is known.
HSTS_INCLUDE_SUBDOMAINS=false

# Typical HTTPS deployment behind a local reverse proxy:
# APP_BASE_URL=https://bot.example.com
# TRUST_PROXY=loopback
# FORCE_HTTPS=true
# SESSION_COOKIE_SECURE=true
